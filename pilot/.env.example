# Public hostname that points to this machine.
DOMAIN=compute-pilot.example.com

# Email used by Caddy for ACME/TLS registration.
ACME_EMAIL=ops@example.com

# Hugging Face token. Leave empty only for models that do not require authentication.
HF_TOKEN=

# Generate with: openssl rand -hex 32
VLLM_API_KEY=replace-with-a-long-random-secret

# Conservative default for a 48 GB GPU. Verify the model licence before customer use.
MODEL_ID=Qwen/Qwen2.5-14B-Instruct-AWQ
SERVED_MODEL_NAME=volta-private-14b
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90

# Optional identifier included in local metrics and logs.
PILOT_ID=volta-pilot-001
