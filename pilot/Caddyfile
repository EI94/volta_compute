{
  email {$ACME_EMAIL}
  admin off
}

{$DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }

  reverse_proxy vllm:8000

  log {
    output file /var/log/caddy/access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
    format json
  }
}
